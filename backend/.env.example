# 渠道真实投递配置模板：复制为 .env 后填写（compose 与 docker-compose.yml 同目录，会自动读它）
# ⚠️ .env 已在 .gitignore 里；把真实凭据写进 yml / compose / 提交到仓库都是不允许的（PRD-27）。
# 只填下面这些键，等号两边不要加空格，值不要加引号。

# ===== 服务密钥（ compose 启动的硬性前置，缺一个就报错退出）=====
# 令牌签名密钥。一旦留空或沿用示例值，任何人都能自签合法 ADMIN 令牌，
# 所以 compose 用的是 ${JWT_SECRET:?}：没有这个键就起不来，不会带着空密钥偷偷跑起来。
# 生成：openssl rand -base64 32  （要 base64 串，后端按 Base64 解码成 HMAC key）
JWT_SECRET=
# 服务间内部接口（/api/**/internal、渠道投递回调等）的共享口令，随机串即可。
# ⚠️ 容器外的开发（IDEA / mvn spring-boot:run）读的是 application.yml 里 internal.api.token
# 默认值，与这里不一致会让内部调用一律 401。
INTERNAL_API_TOKEN=
# postgres 容器的口令。
# ⚠️ 只在【首次创建 pgdata 卷】时生效：卷已存在时改这里不会同步进数据库，
# 会直接连不上。确实要换口令请进容器执行 ALTER USER postgres PASSWORD '...'，
# 或连同新卷重建（那等于清库）。
POSTGRES_PASSWORD=

# ===== 邮件（SMTP，QQ 邮箱实测可用）=====
# 总开关：false 时邮件走模拟发送，通知会记成 SENT + reason=MAIL_MOCK_SEND（不是真投递）
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
# 465 需同时把 MAIL_SSL_ENABLE 置 true（隐式 TLS）；587 用 STARTTLS
MAIL_PORT=587
MAIL_STARTTLS_ENABLE=true
MAIL_SSL_ENABLE=false
# 发件地址必须与登录账号一致，否则 SMTP 直接拒（MAIL_SENDER_INVALID）
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ===== 短信（阿里云 dysmsapi）=====
SMS_ENABLED=false
SMS_ENDPOINT=https://dysmsapi.aliyuncs.com
SMS_REGION_ID=cn-hangzhou
# 阿里云 AccessKey：建议使用只授权 dysms 的子账号，不要用工号/主账号密钥
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 短信签名与"单变量模板"的模板 CODE（阿里云控制台审核通过后回填）
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 正文塞进模板变量的方式：单变量模板用 content；多变量模板按下表逐事件配
SMS_CONTENT_VARIABLE=content
# 阿里云单变量默认最长 20 字，超了会记 SMS_CONTENT_TOO_LONG；按控制台实际配额改
SMS_MAX_VARIABLE_LENGTH=20
SMS_TIMEOUT_MS=8000
# 逐事件的模板 CODE（可选）：填了就走多变量模板，绕开 20 字限制；不填回退 SMS_TEMPLATE_CODE
SMS_EVENT_TEMPLATE_BILL=
SMS_EVENT_TEMPLATE_LOGIN=
SMS_EVENT_TEMPLATE_PROMOTION=
SMS_EVENT_TEMPLATE_RISK_ALERT=
SMS_EVENT_TEMPLATE_SECURITY=
SMS_EVENT_TEMPLATE_TRANSACTION=

# ===== 模拟发送 =====
# 未启用真发渠道时，按这个比例随机失败（0~1），用来演练失败原因码
MOCK_FAILURE_RATE=0.1

# ===== 这里没列的键 =====
# DB_* / REDIS_* / KAFKA_* 在 compose 里，是容器网络内部地址（不是密钥），不要在本文件改。
